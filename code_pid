void calibrateSensors()
{
  // Initialize calibration values
  for (int i = 0; i < nsensor; i++)
  {
    minval[i] = 4095;
    maxval[i] = 0;
  }

 
  // Calibration period
  for (int t = 0; t < 500; t++)
  {
    for (int i = 0; i < nsensor; i++)
    {
      int value = analogRead(pin[i]);

      if (value < minval[i])
      {
        minval[i] = value;
      }

      if (value > maxval[i])
      {
        maxval[i] = value;
      }
    }

    delay(5);
  }

}

void normalizeSensors()
{
  for (int i = 0; i < nsensor; i++)
  {
    normval[i] = map(sensorval[i], minval[i], maxval[i], 0, 1000);
    normval[i] = constrain(normval[i], 0, 1000);
    // in case of inversion, do normal[i] = 1000 - normal[i]
  }
}

long calculatePosition()
{
  long weightedSum = 0;
  long total = 0;

  for (int i = 0; i < nsensor; i++)
  {
    weightedSum += (long)normval[i] * (i * 1000);
    total += normval[i];
  }

  // No sensor sees the line
  /*if (total == 0)
  {
    
    return -1;
  }
*/
  return weightedSum / total;
}

float calculatePID(int error)
{
  P = error/10; 
  
  /*dividing by 15 because if 3000 error occurs, P value becomes 3000*0.18 = 540 slamming the motor speeds high!!!
  we make it 3000/(0.18*15) = 36
  */

  I = I + error;

  D = (error - previousError)/10;

  float PIDvalue = (Kp * P) + (Ki * I) + (Kd * D) + offset;

  previousError = error;

  return PIDvalue;
}

void setMotorSpeed(int rightSpeed, int leftSpeed)
{
  // RIGHT MOTOR - FORWARD
  digitalWrite(AIN1R, HIGH);
  digitalWrite(AIN2R, LOW);

  // LEFT MOTOR - FORWARD
  digitalWrite(BIN1L, HIGH);
  digitalWrite(BIN2L, LOW);

  // Apply PWM speeds
  analogWrite(pwmar, rightSpeed);
  analogWrite(pwmbl, leftSpeed);
}
